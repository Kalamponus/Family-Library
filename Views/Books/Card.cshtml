@model Book
@{
    ViewData["Title"] = Model.Title;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Все книги</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="h3 card-title mb-4">@Model.Title</h1>

        <dl class="row mb-4">
            <dt class="col-sm-3">Автор</dt>
            <dd class="col-sm-9">@Model.Author</dd>

            <dt class="col-sm-3">Дата издания</dt>
            <dd class="col-sm-9">@Model.ReleaseDate.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-3">Описание</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "Не указано" : Model.Description)</dd>
        </dl>

        <h2 class="h5">Оглавление</h2>
        @if (string.IsNullOrWhiteSpace(Model.TableOfContents))
        {
            <p class="text-muted">Оглавление пока не заполнено.</p>
        }
        else
        {
            <div class="border rounded p-3 mb-4">
                @Html.Raw(Model.TableOfContents)
            </div>
        }

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Изменить</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                  data-confirm="Удалить книгу «@Model.Title»? Это действие нельзя отменить.">
                <button type="submit" class="btn btn-outline-danger">Удалить</button>
            </form>
            <a asp-action="Index" class="btn btn-outline-secondary ms-sm-auto">Назад к списку</a>
        </div>
    </div>
</div>
