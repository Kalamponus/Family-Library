@using FamilyLibrary.ViewModels
@model BookFormViewModel
@{
    ViewData["Title"] = "Новая книга";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <h1 class="h3 mb-4">Новая книга</h1>

        <div class="card shadow-sm">
            <div class="card-body">
                <form id="book-form" asp-action="Create" method="post">
                    <partial name="_BookFormFields" model="Model" />
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Отмена</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_BookFormScripts" />
}
