@using FamilyLibrary.ViewModels
@model BookFormViewModel
@{
    ViewData["Title"] = "Изменение книги";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <h1 class="h3 mb-4">Изменение книги</h1>

        <div class="card shadow-sm">
            <div class="card-body">
                <form id="book-form" asp-action="Edit" method="post">
                    <partial name="_BookFormFields" model="Model" />
                    <a asp-action="Card" asp-route-id="@Context.Request.RouteValues["id"]" class="btn btn-outline-secondary ms-2">Отмена</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_BookFormScripts" />
}
