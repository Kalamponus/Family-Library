@using FamilyLibrary.ViewModels

@model BookListViewModel

<h1>Домашняя библиотека</h1>

@if (TempData["Message"] != null)
{
    var type = TempData["MessageType"]?.ToString() ?? "success";
    <div class="toast-notification toast-@type">@TempData["Message"]</div>
}

<form asp-action="Index" method="get">
    <input type="text" name="searchQuery" value="@Model.SearchQuery" placeholder="Поиск..." />
    <select name="searchType">
        <option value="0" selected="@(Model.SearchType == SearchType.ByTitle)">По названию</option>
        <option value="1" selected="@(Model.SearchType == SearchType.ByAuthor)">По автору</option>
        <option value="2" selected="@(Model.SearchType == SearchType.ByDescription)">По описанию</option>
        <option value="3" selected="@(Model.SearchType == SearchType.ByTableOfContents)">По оглавлению</option>
    </select>
    <button type="submit">Найти</button>
</form>

<a asp-action="Create">+ Добавить книгу</a>

<table>
    <thead>
        <tr><th>Название</th><th>Автор</th><th>Год</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var book in Model.Books)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.ReleaseDate.Year</td>
                <td>
                    <a asp-action="Card" asp-route-id="@book.Id">Открыть</a>
                    <a asp-action="Edit" asp-route-id="@book.Id">Редактировать</a>

                    <form asp-action="Delete" asp-route-id="@book.Id" method="post"
                          onsubmit="return confirm('Удалить книгу «@book.Title»? Это действие нельзя отменить.');"
                          style="display:inline">
                        <button type="submit">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Books.Any())
{
    <p>Книг не найдено.</p>
}

@for (int i = 1; i <= Model.TotalPages; i++)
{
    <a asp-action="Index"
       asp-route-page="@i"
       asp-route-searchQuery="@Model.SearchQuery"
       asp-route-searchType="@Model.SearchType"
       class="@(i == Model.CurrentPage ? "active" : "")">@i</a>
}
