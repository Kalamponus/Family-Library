@model int
@{
    ViewData["Title"] = "Ошибка";

    var (heading, text) = Model switch
    {
        404 => ("Страница не найдена",
                "Возможно, книгу удалили или в адресе опечатка. Вернитесь к списку и найдите нужную."),
        400 => ("Не удалось обработать запрос",
                "Проверьте введённые данные и попробуйте ещё раз."),
        _   => ("Что-то пошло не так",
                "Действие не выполнено из-за ошибки на сервере. Попробуйте повторить его чуть позже.")
    };
}

<div class="text-center py-5">
    <p class="display-1 fw-bold text-muted mb-3">@Model</p>
    <h1 class="h3 mb-3">@heading</h1>
    <p class="text-muted mb-4">@text</p>
    <a asp-controller="Books" asp-action="Index" class="btn btn-primary">К списку книг</a>
    <p class="small text-muted mt-4 mb-0">Код запроса: <code>@Context.TraceIdentifier</code></p>
</div>
