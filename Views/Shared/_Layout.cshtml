<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Домашняя библиотека</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Books" asp-action="Index">Домашняя библиотека</a>
        </div>
    </nav>

    @if (TempData["Message"] is string message)
    {
        var isError = TempData["MessageType"]?.ToString() == "error";
        <div class="toast-container position-fixed top-0 end-0 p-3">
            <div id="appToast" class="toast align-items-center text-white border-0 @(isError ? "bg-danger" : "bg-success")"
                 role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">@message</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast" aria-label="Закрыть"></button>
                </div>
            </div>
        </div>
    }

    <main class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="border-top py-3 text-muted">
        <div class="container small">© @DateTime.Now.Year Домашняя библиотека</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const toastEl = document.getElementById('appToast');
        if (toastEl) {
            bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 4000 }).show();
        }

        document.addEventListener('submit', function (e) {
            const message = e.target.dataset.confirm;
            if (message && !confirm(message)) {
                e.preventDefault();
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
